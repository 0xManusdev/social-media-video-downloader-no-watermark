# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Max file size in MB for Telegram uploads (Bot API limit is 50MB)
MAX_FILE_SIZE_MB=50

# Temporary download directory
DOWNLOAD_DIR=./downloads

# Comma-separated Telegram user IDs allowed to run /stats
ADMIN_IDS=

# Netscape-format cookies file (export from a logged-in browser with a "Get cookies.txt" extension).
# Strongly recommended for Instagram: anonymous access is rate-limited and often returns no media.
COOKIES_FILE=

# Seconds a user must wait between two links
COOLDOWN_SECONDS=5

# Max simultaneous yt-dlp processes
MAX_CONCURRENT_DOWNLOADS=3

# Optional hard timeout per download in ms (default scales with MAX_FILE_SIZE_MB)
DOWNLOAD_TIMEOUT_MS=
